# Copie para .env.production (fora do git) e preencha os valores marcados com <...>.
# Gere a chave com: docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show

# Domínio público (Caddy emite o certificado TLS automaticamente via Let's Encrypt)
APP_DOMAIN=<rifa.exemplo.com.br>
ACME_EMAIL=<ops@exemplo.com.br>

APP_NAME="Rifa SaaS"
APP_ENV=production
APP_KEY=<base64:...>
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://<rifa.exemplo.com.br>
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# Logs no stderr (docker logs, com rotação) e em arquivo diário no volume de storage
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rifa
DB_USERNAME=rifa
DB_PASSWORD=<senha-forte>
DB_ROOT_PASSWORD=<outra-senha-forte>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=rifa_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=<senha-redis>
REDIS_PORT=6379

# SMTP transacional (ex.: Amazon SES, Postmark, Mailgun, Brevo)
MAIL_MAILER=smtp
MAIL_HOST=<smtp.provedor.com>
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=<usuario>
MAIL_PASSWORD=<senha>
MAIL_FROM_ADDRESS="nao-responda@<rifa.exemplo.com.br>"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# SaaS de rifas
RAFFLE_SALES_ENABLED=false
RAFFLE_RESERVATION_TTL=10
RAFFLE_MAX_NUMBERS=100000
PLATFORM_FEE_PERCENT=5
PAYMENT_GATEWAY=mercadopago
PAYMENT_GATEWAYS=
REQUIRE_ADMIN_2FA=true

# Asaas
ASAAS_ENV=production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Mercado Pago — credenciais de produção da aplicação marketplace.
# Redirect URL: https://<rifa.exemplo.com.br>/painel/configuracoes/mercadopago/retorno
# Webhook:      https://<rifa.exemplo.com.br>/webhooks/payments/mercadopago
MERCADOPAGO_ENV=production
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_TEST_TOKEN=false
MERCADOPAGO_TEST_PAYER_EMAIL=
MERCADOPAGO_WEBHOOK_SECRET=

# Somente o Caddy (rede interna do compose) é proxy confiável
TRUSTED_PROXIES=172.28.0.0/16
